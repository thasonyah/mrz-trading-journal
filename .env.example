PORT=5174
JWT_SECRET=change-this-in-production
NODE_ENV=production
DATABASE_PATH=./data/trading-journal.sqlite
# Set DATABASE_URL to a PostgreSQL or MySQL/MariaDB URL to use a hosted database.
# If DATABASE_URL is omitted, DATABASE_PATH is used for local SQLite development.
DATABASE_URL=
DATABASE_SSL=false
PUBLIC_BASE_URL=http://127.0.0.1:5174
# Comma-separated browser origins allowed to call the API in production.
CORS_ORIGINS=http://127.0.0.1:5173

# Optional email delivery. If these are omitted, verification/reset links are shown
# in the app response and server logs for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Production safety
# Keep false unless you intentionally want demo data in production.
DEMO_SEED_ENABLED=false
