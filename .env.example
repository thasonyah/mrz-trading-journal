PORT=5174
JWT_SECRET=change-this-in-production
DATABASE_PATH=./data/trading-journal.sqlite
# Render Postgres sets DATABASE_URL automatically from render.yaml.
# If DATABASE_URL is present, it is used instead of DATABASE_PATH.
DATABASE_URL=
DATABASE_SSL=false
PUBLIC_BASE_URL=http://127.0.0.1:5174

# Optional email delivery. If these are omitted, verification/reset links are shown
# in the app response and server logs for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
